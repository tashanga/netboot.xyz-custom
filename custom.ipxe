#!ipxe
# Benutzerdefiniertes Menü: Debian Live direkt aus dem Internet streamen

:custom_menu
menu Debian Live-Systeme (Internet Streaming via GitHub)
item --gap -- Waehle eine Desktop-Umgebung:
item debian_gnome   Debian Live (GNOME Desktop - Modern)
item debian_xfce    Debian Live (XFCE Desktop - Leichtgewichtig)
item debian_cinnamon Debian Live (Cinnamon Desktop)
item --gap -- Navigation:
item return Zurueck zum Hauptmenue
choose --default return --timeout 15000 target && goto ${target}

:debian_gnome
# Definiert das aktuelle Release-Tag aus dem GitHub-Repository
set release_tag 2026.2-6fd5ce88
set flavor gnome-13
set base_url https://github.com{release_tag}
echo Streaming Debian Live GNOME via HTTPS...
# 'fetch=' sagt dem Kernel, woher er das SquashFS-Dateisystem zur Laufzeit laden soll
kernel ${base_url}/vmlinuz boot=live fetch=${base_url}/${flavor}-filesystem.squashfs initrd=initrd ip=dhcp netboot=http
initrd ${base_url}/initrd
boot
goto custom_menu

:debian_xfce
set release_tag 2026.2-6fd5ce88
set flavor xfce-13
set base_url https://github.com{release_tag}
echo Streaming Debian Live XFCE via HTTPS...
kernel ${base_url}/vmlinuz boot=live fetch=${base_url}/${flavor}-filesystem.squashfs initrd=initrd ip=dhcp netboot=http
initrd ${base_url}/initrd
boot
goto custom_menu

:debian_cinnamon
set release_tag 2026.2-6fd5ce88
set flavor cinnamon-13
set base_url https://github.com{release_tag}
echo Streaming Debian Live Cinnamon via HTTPS...
kernel ${base_url}/vmlinuz boot=live fetch=${base_url}/${flavor}-filesystem.squashfs initrd=initrd ip=dhcp netboot=http
initrd ${base_url}/initrd
boot
goto custom_menu

:return
chain --replace --errorcmd menu_failed ${menu_url}
#!ipxe
# Erweiterung für dein GitHub netboot.xyz Menü: Arch Linux Live-Streaming

:custom_menu
menu Arch Linux-basierte Systeme (Internet Streaming)
item --gap -- Waehle eine Distribution:
item arch_pure     Arch Linux (Offizielles CLI/Live-Medium)
item cachy_os     CachyOS (Performance-optimiert mit Desktop)
item manjaro_xfce  Manjaro Linux (XFCE Desktop)
item --gap -- Navigation:
item return Zurueck zum Hauptmenue
choose --default return --timeout 15000 target && goto ${target}

:arch_pure
# Arch nutzt rolling Releases. netboot.xyz pflegt die Kernel-Assets direkt.
set upstream_url https://netboot.xyz
echo Streaming Pure Arch Linux Live Media...
# Wichtig: 'archiso_http_srv' zeigt auf das Verzeichnis, in dem das SquashFS liegt
kernel https://archlinux.org
# Für das offizielle Arch nutzen wir meist die standardmaessigen netboot.xyz Kernels:
chain --autofree http://netboot.xyz
goto custom_menu

:cachy_os
# CachyOS nutzt optimierte x86-64-v3/v4 Repositories
set release_tag 240618-91a2b3c
set base_url https://github.com{release_tag}
echo Streaming CachyOS Desktop Environment...
# archisobasedir legt fest, in welchem Unterordner das System nach den Boot-Dateien sucht
kernel ${base_url}/vmlinuz archisobasedir=arch archiso_http_srv=${base_url}/ ip=dhcp netboot=http
initrd ${base_url}/initramfs.img
boot
goto custom_menu

:manjaro_xfce
# Manjaro Live-System über das netboot.xyz-eigene SquashFS-Repository
set release_tag 23.1.3-f8ca31b
set base_url https://github.com{release_tag}
echo Streaming Manjaro Live XFCE via HTTPS...
kernel ${base_url}/vmlinuz archisobasedir=manjaro archiso_http_srv=${base_url}/ ip=dhcp netboot=http
initrd ${base_url}/initrd
boot
goto custom_menu

:return
chain --replace --errorcmd menu_failed ${menu_url}
